#!/bin/bash
# kimi-switch — 一键切换 Kimi Code CLI 账号
#
# 原理：Kimi Code 的登录态保存在 ~/.kimi-code/credentials/kimi-code.json，
# config.toml 里还有一行 api_key。本工具把这两样按账号名做快照、来回换。
# CLI 每次 API 请求都重读凭证文件（0.39 源码核实），所以换掉 live 文件后
# 运行中的会话下一次请求即生效——切换是热切换，无需重启会话。
#
# 用法：
#   kimi-switch               只有两个账号时直接互换；否则弹出编号菜单
#   kimi-switch save <名字>   把当前登录态存为账号快照（先 /login 再 save）
#   kimi-switch use <名字>    切换到指定账号
#   kimi-switch rotate       无交互切到有额度的最佳其他账号
#   kimi-switch best [-v]    按平衡策略选出的账号（-v 看各账号评分明细）
#   kimi-switch watch        5h 预判守护：快用超前自动热切（--once 单次检查，给 launchd/cron）
#   kimi-switch go            自动切到余量最多的账号并启动 kimi
#   kimi-switch usage         查看所有账号的用量
#   kimi-switch ls            列出所有账号，* 号表示当前生效的
#   kimi-switch current       显示当前是哪个账号
#   kimi-switch rm <名字>     删除一个账号快照
#   kimi-switch statusline    状态栏输出（给 tui.toml 的 status_line.command 用）

set -euo pipefail

KIMI_HOME="${KIMI_CODE_HOME:-$HOME/.kimi-code}"
CRED="$KIMI_HOME/credentials/kimi-code.json"
CONFIG="$KIMI_HOME/config.toml"
PROFILES="$KIMI_HOME/accounts"
CACHE="$PROFILES/.usage-cache.json"
CURRENT_FILE="$PROFILES/.current"
PREFS="$PROFILES/prefs.conf"
DIRS="$PROFILES/.dirs"
mkdir -p "$PROFILES"
chmod 700 "$PROFILES"

# 偏好文件：每次 go 启动前套用到 config.toml，解决 CLI 每次打开都要重选的问题
# permission=auto 即新版 Never Ask：全程不确认直接执行（yolo 仍会对危险命令/敏感文件/退 Plan 确认）
if [ ! -f "$PREFS" ]; then
    cat > "$PREFS" <<'EOF'
model=kimi-code/k3
permission=auto
effort=max
EOF
fi

# ---------- bash 小工具 ----------

# macOS 的 BSD sed 要写成 -i ''，GNU sed（Linux / Windows Git Bash）的 -i 不接受这个参数
sed_i() {
    if sed --version >/dev/null 2>&1; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

# Windows 上常常没有 python3 命令（只有 python 或 py 启动器），
# 微软商店占位的 python3.exe 也不能用，所以要真的跑一下验证
PY=()
for _pycand in python3 python; do
    if command -v "$_pycand" >/dev/null 2>&1 && "$_pycand" -c '' >/dev/null 2>&1; then
        PY=("$_pycand")
        break
    fi
done
if [ "${#PY[@]}" -eq 0 ] && command -v py >/dev/null 2>&1 && py -3 -c '' >/dev/null 2>&1; then
    PY=(py -3)
fi
unset _pycand

# Windows 原生 Python 的 stdio 和文本文件默认用系统 ANSI 码页（中文系统是 GBK），
# 中文输出到 UTF-8 终端 / kimi 状态栏会变成乱码，写出的 .statusline.txt 也是 GBK。
# 强制 UTF-8 模式；对 macOS / Linux 无害（那边本来就是 UTF-8）。
export PYTHONUTF8=1

# 嵌进 python 代码字符串里的路径：MSYS2 只转换独立的命令行参数，
# 嵌在代码里的 /c/... 不会被转换，Windows 原生 Python 不认识，需用 cygpath 转成 C:/...
py_path() {
    if command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s' "$1"
    fi
}

# 从 prefs.conf 读数值型偏好（threshold/interval），缺省或非法时给默认值
pref_val() {
    local key="$1" default="$2" v
    v=$(sed -n "s/^${key}=//p" "$PREFS" 2>/dev/null | head -1)
    case "$v" in
        ''|*[!0-9]*) echo "$default" ;;
        *)           echo "$v" ;;
    esac
}

# 从 config.toml 提取当前 api_key（可能为空）
current_api_key() {
    sed -n 's/^[[:space:]]*api_key = "\(.*\)"[[:space:]]*$/\1/p' "$CONFIG" 2>/dev/null | head -1
}

# 把 api_key 写回 config.toml
write_api_key() {
    local key="$1"
    local escaped
    escaped=$(printf '%s' "$key" | sed 's/[&|\\]/\\&/g')
    if grep -q '^[[:space:]]*api_key = ' "$CONFIG"; then
        sed_i "s|^[[:space:]]*api_key = \".*\"|api_key = \"$escaped\"|" "$CONFIG"
    fi
}

# 判断某个快照是否为当前登录态（比内容，不打印任何密钥）
is_current() {
    local name="$1"
    local snap="$PROFILES/${name}.credentials.json"
    [ -f "$snap" ] && [ -f "$CRED" ] && cmp -s "$snap" "$CRED"
}

# 记住当前账号名（statusline 用；文件比对在 CLI 自动刷新 token 后会失效，名字不会）
mark_current() {
    printf '%s' "$1" > "$CURRENT_FILE"
    chmod 600 "$CURRENT_FILE"
    # 账号变了，预渲染的状态栏文本同步刷新（静默，失败无碍）
    ks_py statusline "$PROFILES" "$CRED" "$CACHE" >/dev/null 2>&1 || true
}

# ---------- python 后端（网络请求都在这里） ----------

ks_py() {
    if [ "${#PY[@]}" -eq 0 ]; then
        echo "错误：找不到可用的 Python 3 解释器（试过 python3 / python / py -3）" >&2
        return 1
    fi
    "${PY[@]}" - "$@" <<'PYEOF'
import glob, json, os, sys, time
import urllib.request, urllib.parse
from datetime import datetime

CLIENT_ID = '17e5f671-d194-4dfb-9706-5516cb48c098'
TOKEN_URL = 'https://auth.kimi.com/api/oauth/token'
BASE_URL = 'https://api.kimi.com/coding/v1'
USAGE_URL = BASE_URL + '/usages'
ME_URL = BASE_URL + '/me'
WEEK_SECONDS = 7 * 86400
# 测试缝：指向一个目录时，query_account 改读 <目录>/<账号>.usage.json，freshen 直接通过，全程不碰网络
FIXTURES = os.environ.get('KS_USAGE_FIXTURES') or ''

cmd = sys.argv[1]
profiles_dir = sys.argv[2] if len(sys.argv) > 2 else ''
live_cred_path = sys.argv[3] if len(sys.argv) > 3 else ''
cache_path = sys.argv[4] if len(sys.argv) > 4 else ''

def load(path):
    with open(path) as f:
        return json.load(f)

def save_json(path, data):
    with open(path, 'w') as f:
        json.dump(data, f)
    os.chmod(path, 0o600)

def refresh(cred):
    body = urllib.parse.urlencode({
        'client_id': CLIENT_ID,
        'refresh_token': cred['refresh_token'],
        'grant_type': 'refresh_token',
    }).encode()
    req = urllib.request.Request(TOKEN_URL, data=body)
    with urllib.request.urlopen(req, timeout=15) as r:
        resp = json.load(r)
    cred.update({k: resp[k] for k in ('access_token', 'refresh_token', 'expires_in', 'scope', 'token_type') if k in resp})
    cred['expires_at'] = int(time.time()) + int(resp.get('expires_in', 900))
    return cred

def ensure_fresh(cred):
    return refresh(cred) if cred.get('expires_at', 0) < time.time() + 60 else cred

def authed_get(url, cred):
    req = urllib.request.Request(url, headers={'Authorization': 'Bearer ' + cred['access_token']})
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.load(r)

def fmt_reset(iso):
    if not iso:
        return ''
    t = datetime.fromisoformat(iso.replace('Z', '+00:00')).astimezone()
    now = datetime.now().astimezone()
    return t.strftime('%H:%M') if t.date() == now.date() else t.strftime('%m-%d %H:%M')

def used_of(d):
    if not d:
        return None, None
    limit = d.get('limit')
    used = d.get('used')
    if used is None and d.get('remaining') is not None and limit is not None:
        used = int(limit) - int(d['remaining'])
    return (int(used) if used is not None else 0), (int(limit) if limit is not None else None)

def window_label(win):
    dur, unit = (win or {}).get('duration'), (win or {}).get('timeUnit', '')
    if unit == 'TIME_UNIT_MINUTE' and dur and dur % 60 == 0:
        return '%s小时窗口' % (dur // 60)
    return '%s%s窗口' % (dur, {'TIME_UNIT_MINUTE': '分钟', 'TIME_UNIT_HOUR': '小时', 'TIME_UNIT_DAY': '天', 'TIME_UNIT_WEEK': '周'}.get(unit, unit))

def profiles():
    return sorted(glob.glob(os.path.join(profiles_dir, '*.credentials.json')))

def profile_name(path):
    return os.path.basename(path)[:-len('.credentials.json')]

def read_identity(name):
    info_path = os.path.join(profiles_dir, name + '.info')
    try:
        return load(info_path)
    except Exception:
        return {}

def query_account(path):
    """刷新（如需要）并查询用量。返回 (cred, usage_data)，抛异常表示失败。"""
    if FIXTURES:
        fx = os.path.join(FIXTURES, profile_name(path) + '.usage.json')
        if not os.path.exists(fx):
            raise Exception('缺少 fixture 文件：%s' % fx)
        return load(path), load(fx)
    cred = load(path)
    fresh = ensure_fresh(cred)
    if fresh is not cred or fresh != load(path):
        save_json(path, fresh)
    cred = fresh
    return cred, authed_get(USAGE_URL, cred)

def cache_entry(data):
    entry = {'ts': int(time.time())}
    w_used, w_limit = used_of(data.get('usage'))
    if w_limit is not None:
        entry['week_used'], entry['week_limit'] = w_used, w_limit
        entry['week_reset'] = (data.get('usage') or {}).get('resetTime', '')
    for row in data.get('limits') or []:
        win = row.get('window') or {}
        if win.get('timeUnit') == 'TIME_UNIT_MINUTE' and win.get('duration') == 300:
            u, l = used_of(row.get('detail'))
            entry['h5_used'], entry['h5_limit'] = u, l
            entry['h5_reset'] = (row.get('detail') or {}).get('resetTime', '')
    return entry

def reset_ts(iso):
    if not iso:
        return None
    try:
        return datetime.fromisoformat(iso.replace('Z', '+00:00')).timestamp()
    except Exception:
        return None

def quotas(data):
    """提取 5h 窗口和周额度的 used/limit/reset_ts，未知为 None。"""
    w_used, w_limit = used_of(data.get('usage'))
    q = {'h5_used': None, 'h5_limit': None, 'h5_reset': None,
         'week_used': w_used, 'week_limit': w_limit,
         'week_reset': reset_ts((data.get('usage') or {}).get('resetTime'))}
    for row in data.get('limits') or []:
        win = row.get('window') or {}
        if win.get('timeUnit') == 'TIME_UNIT_MINUTE' and win.get('duration') == 300:
            q['h5_used'], q['h5_limit'] = used_of(row.get('detail'))
            q['h5_reset'] = reset_ts((row.get('detail') or {}).get('resetTime'))
            break
    return q

def balance_key(data, now):
    """平衡排序键：(surplus 档位, 5h剩余, 周剩余, surplus 原值)。大的优先。
    surplus = 周剩余占比 − 本周期剩余时间占比：越大说明照当前节奏重置前用不完，越要先用
    （“谁快重置且剩得多，先用谁”）。档位按 5 个百分点取整，同档由 5h 剩余裁决。"""
    q = quotas(data)
    h5_rem = (q['h5_limit'] - q['h5_used']) if q['h5_limit'] is not None else -1
    w_rem = (q['week_limit'] - q['week_used']) if q['week_limit'] is not None else -1
    surplus = 0.0
    if q['week_limit'] and q['week_reset']:
        time_frac = min(1.0, max(0.0, q['week_reset'] - now) / WEEK_SECONDS)
        surplus = w_rem / q['week_limit'] - time_frac
    bucket = int(round(surplus / 0.05))
    return (bucket, h5_rem, w_rem, surplus)

def rank_accounts(now, min_h5_pct, exclude=None):
    """查询所有账号并按平衡策略排序。返回 (candidates, skipped, h5_resets)：
    candidates 已过不可用的硬门槛（周剩余>0、5h 剩余>min_h5_pct%），按优先级降序；
    skipped 是被排除的 [(name, key|None, quotas|None, 原因)]；
    h5_resets 是所有查询成功账号的 5h 重置时间戳（watch 的 WAIT 用）。"""
    cands, skipped, resets = [], [], []
    for path in profiles():
        name = profile_name(path)
        if exclude and name == exclude:
            continue
        try:
            _, data = query_account(path)
        except Exception as e:
            skipped.append((name, None, None, '查询失败：%s' % e))
            continue
        update_cache(name, cache_entry(data))
        q = quotas(data)
        if q['h5_reset']:
            resets.append(q['h5_reset'])
        key = balance_key(data, now)
        h5_rem, w_rem = key[1], key[2]
        if w_rem == 0:
            skipped.append((name, key, q, '周额度已用尽'))
            continue
        if q['h5_limit'] is None:
            skipped.append((name, key, q, '5h 数据缺失'))
            continue
        if h5_rem <= q['h5_limit'] * min_h5_pct / 100.0:
            skipped.append((name, key, q, '5h 剩 %d/%d 低于 %d%% 门槛' % (h5_rem, q['h5_limit'], min_h5_pct)))
            continue
        cands.append((name, key, q, None))
    cands.sort(key=lambda r: r[1], reverse=True)
    return cands, skipped, resets

def fmt_duration(secs):
    secs = int(secs)
    if secs <= 0:
        return '即将重置'
    d, r = divmod(secs, 86400)
    h, m = r // 3600, (r % 3600) // 60
    if d:
        return '%d天%d小时' % (d, h)
    return '%d小时%d分' % (h, m) if h else '%d分' % m

def print_score_row(name, key, q, note, current, now):
    label = name + ('（当前）' if name == current else '')
    if key is None or q is None:
        print('%-14s %-10s %-10s %-10s %-7s %s' % (label, '?', '?', '?', '?', note))
        return
    h5 = '%d/%d' % (key[1], q['h5_limit']) if q['h5_limit'] is not None else '?'
    wk = '%d/%d' % (key[2], q['week_limit']) if q['week_limit'] is not None else '?'
    rst = fmt_duration(q['week_reset'] - now) if q['week_reset'] else '?'
    print('%-14s %-10s %-10s %-10s %-7s %s' % (label, h5, wk, rst, '%+.2f' % key[3], note))

def current_profile_name():
    try:
        marked = open(os.path.join(profiles_dir, '.current')).read().strip()
        if marked and os.path.exists(os.path.join(profiles_dir, marked + '.credentials.json')):
            return marked
    except Exception:
        pass
    try:
        live = open(live_cred_path, 'rb').read()
    except Exception:
        return ''
    for path in profiles():
        try:
            if open(path, 'rb').read() == live:
                return profile_name(path)
        except Exception:
            continue
    return ''

def update_cache(name, entry):
    cache = {}
    if cache_path:
        try:
            cache = load(cache_path)
        except Exception:
            cache = {}
        cache[name] = entry
        save_json(cache_path, cache)

def sync_live():
    """CLI 每次请求都重读 live 凭证，刷新后会把轮转的新凭证写回 live，但快照不更新，
    放着不管快照最终会因 refresh_token 被轮转而失效（invalid_grant）。
    这里把 live 回同步到 .current 标记账号的快照（use/usage/best 入口都会调用）。
    已知边界：若绕开本工具直接 /login 成别的账号，.current 启发式会把凭证存错快照——
    但不同步则快照必死，两害相权取同步。"""
    try:
        name = open(os.path.join(profiles_dir, '.current')).read().strip()
    except Exception:
        return
    if not name:
        return
    snap_path = os.path.join(profiles_dir, name + '.credentials.json')
    if not (os.path.exists(snap_path) and os.path.exists(live_cred_path)):
        return
    try:
        live_raw = open(live_cred_path, 'rb').read()
        if live_raw == open(snap_path, 'rb').read():
            return
        if os.path.getmtime(live_cred_path) <= os.path.getmtime(snap_path):
            return
        live_cred = json.loads(live_raw)
    except Exception:
        return
    if not live_cred.get('access_token'):  # 空 token 墓碑不回同步
        return
    save_json(snap_path, live_cred)
    print('已将运行中刷新的凭证回同步到「%s」快照' % name)

def statusline_text():
    # 只读本地缓存，绝不发网络请求（状态栏有 300ms 预算，超时会回退内置布局造成闪烁）
    name = ''
    try:
        name = open(os.path.join(profiles_dir, '.current')).read().strip()
    except Exception:
        pass
    cache = {}
    try:
        cache = load(cache_path)
    except Exception:
        pass
    entry = cache.get(name) if name else None
    ident = read_identity(name) if name else {}
    label = name or '?'
    if ident.get('nickname'):
        label = '%s(%s)' % (label, ident['nickname'])
    if not entry:
        return '%s · 用量未知，跑一次 kimi-switch usage' % label
    parts = [label]
    if 'week_limit' in entry:
        parts.append('周剩%s/%s' % (entry['week_limit'] - entry['week_used'], entry['week_limit']))
    if 'h5_limit' in entry:
        parts.append('5h剩%s/%s' % (entry['h5_limit'] - entry['h5_used'], entry['h5_limit']))
    return ' · '.join(parts)

def write_statusline_file(text):
    # 预渲染到 .statusline.txt：statusline 命令直接 cat，不启动 python
    try:
        with open(os.path.join(profiles_dir, '.statusline.txt'), 'w') as f:
            f.write(text + '\n')
    except Exception:
        pass

if cmd == 'synclive':
    # argv: synclive <profiles_dir> <live_cred>
    sync_live()

elif cmd == 'freshen':
    # argv: freshen <profiles_dir> <snapshot_path>
    # use 的前置校验：token 剩余有效期低于 CLI 刷新阈值（max(300, expires_in/2)，加 30s 余量）就先刷新。
    # 退出码：0=可用；3=refresh_token 已死（HTTP 400/401），调用方应中止切换；1=其他错误
    if FIXTURES:
        sys.exit(0)
    snap_path = sys.argv[3]
    try:
        cred = load(snap_path)
        threshold = max(300, cred.get('expires_in', 900) * 0.5) + 30
        if cred.get('expires_at', 0) - time.time() < threshold:
            cred = refresh(cred)
            save_json(snap_path, cred)
        sys.exit(0)
    except urllib.error.HTTPError as e:
        sys.exit(3 if e.code in (400, 401) else 1)
    except Exception:
        sys.exit(1)

elif cmd == 'saveinfo':
    # argv: saveinfo <profiles_dir> <cred_snapshot> <live_cred>
    snap_path, live_path = sys.argv[3], sys.argv[4]
    name = profile_name(snap_path)
    cred = load(snap_path)
    cred = ensure_fresh(cred)
    save_json(snap_path, cred)
    # 快照和 live 是同一份时，把刷新后的 token 同步回 live，避免刷新令牌轮转失效
    try:
        if open(live_path, 'rb').read() and load(live_path).get('refresh_token') != cred.get('refresh_token'):
            save_json(live_path, cred)
    except Exception:
        pass
    info = authed_get(ME_URL, cred)
    out = {
        'nickname': info.get('nickname', ''),
        'phone': (info.get('phone') or {}).get('number', ''),
        'user_id': info.get('user_id', ''),
    }
    save_json(os.path.join(profiles_dir, name + '.info'), out)
    who = ' '.join(x for x in [out['nickname'], out['phone']] if x)
    print('  身份：%s' % (who or out['user_id'] or '未知'))

elif cmd == 'usage':
    live = open(live_cred_path, 'rb').read() if os.path.exists(live_cred_path) else None
    sync_live()
    files = profiles()
    if not files:
        print('还没有保存任何账号')
        sys.exit(0)
    for path in files:
        name = profile_name(path)
        current = live is not None and open(path, 'rb').read() == live
        ident = read_identity(name)
        who = ' '.join(x for x in [ident.get('nickname', ''), ident.get('phone', '')] if x)
        print('账号 %s%s%s' % (name, '（当前）' if current else '', ' · ' + who if who else ''))
        try:
            cred, data = query_account(path)
            if current and cred != load(live_cred_path):
                save_json(live_cred_path, cred)
        except urllib.error.HTTPError as e:
            print('  查询失败（HTTP %s）%s' % (e.code, '，登录态已失效，请 /login 后重新 save' if e.code in (400, 401) else ''))
            continue
        except Exception as e:
            print('  查询失败：%s' % e)
            continue

        update_cache(name, cache_entry(data))

        level = (data.get('user') or {}).get('membership', {}).get('level', '')
        if level:
            print('  会员等级：%s' % level.replace('LEVEL_', ''))

        weekly, wlimit = used_of(data.get('usage'))
        if wlimit is not None:
            print('  每周额度：%s/%s，%s 重置' % (weekly, wlimit, fmt_reset((data.get('usage') or {}).get('resetTime'))))

        for row in data.get('limits') or []:
            used, limit = used_of(row.get('detail'))
            print('  %s：%s/%s，%s 重置' % (window_label(row.get('window')), used, limit, fmt_reset((row.get('detail') or {}).get('resetTime'))))

        wallet = data.get('boosterWallet')
        if wallet:
            cents = int((wallet.get('monthlyUsed') or {}).get('priceInCents') or 0)
            extra = '加油包：本月已用 ¥%.2f' % (cents / 100)
            if wallet.get('status') == 'STATUS_DISABLED':
                extra += '（未开启）'
            print('  %s' % extra)
        print()
    write_statusline_file(statusline_text())

elif cmd == 'best':
    # argv: best <profiles_dir> <live_cred> <cache> [min_h5_pct] [--verbose]
    # 平衡策略选号：硬门槛（周剩余>0、5h 剩余>min_h5_pct%）→ 节奏盈余档位 → 5h 剩余 → 周剩余。
    # 迟滞：当前账号与第一名同档（surplus 差 <5pp）时保持不动。全部不过门槛时回退到余量最大者。
    extra = sys.argv[5:]
    verbose = '--verbose' in extra
    nums = [a for a in extra if a != '--verbose']
    min_h5_pct = float(nums[0]) if nums else 0.0
    sync_live()
    now = time.time()
    current = current_profile_name()
    cands, skipped, _ = rank_accounts(now, min_h5_pct)
    fallback = False
    if not cands:
        pool = [(n, k, q, None) for (n, k, q, _) in skipped if k is not None]
        pool.sort(key=lambda r: r[1], reverse=True)
        cands, fallback = pool[:1], True
    chosen = cands[0][0] if cands else None
    kept = False
    if chosen and current and chosen != current and not fallback:
        cur = next((r for r in cands if r[0] == current), None)
        if cur is not None and cands[0][1][0] - cur[1][0] < 1:
            chosen, kept = current, True
    if verbose:
        print('%-14s %-10s %-10s %-10s %-7s %s' % ('账号', '5h剩余', '周剩余', '距周重置', '节奏盈余', '说明'))
        for n, k, q, _ in cands:
            note = ''
            if n == chosen:
                note = '← 选用' + ('（与最优同档，保持当前）' if kept else '') + ('（全员未过门槛，回退取余量最大）' if fallback else '')
            print_score_row(n, k, q, note, current, now)
        for n, k, q, why in skipped:
            if n != chosen:
                print_score_row(n, k, q, why + '，排除', current, now)
    write_statusline_file(statusline_text())
    print(chosen or '')

elif cmd == 'best-other':
    # argv: best-other <profiles_dir> <live_cred> <cache> [min_h5_pct]
    # 给自动化调用：排除当前账号，按平衡策略选最佳。min_h5_pct 为 5h 门槛百分比：
    # rotate 传 0（被动场景，有剩余即可），watch 传阈值（不切去同样快见底的账号）。
    sync_live()
    min_h5_pct = float(sys.argv[5]) if len(sys.argv) > 5 else 0.0
    cands, _, _ = rank_accounts(time.time(), min_h5_pct, exclude=current_profile_name())
    write_statusline_file(statusline_text())
    print(cands[0][0] if cands else '')

elif cmd == 'watchcheck':
    # argv: watchcheck <profiles_dir> <live_cred> <cache> [threshold_pct] [interval_sec]
    # 5h 预判检查。单行输出动作：STAY <原因> / SWITCH <名字> <原因> / WAIT <秒数> <原因>。
    # 平稳期只查当前账号（省请求），触发后才查其他账号选目标。
    sync_live()
    threshold = float(sys.argv[5]) if len(sys.argv) > 5 else 10.0
    interval = int(sys.argv[6]) if len(sys.argv) > 6 else 180
    now = time.time()
    cur = current_profile_name()
    if not cur:
        print('STAY 未识别当前账号')
        sys.exit(0)
    try:
        _, data = query_account(os.path.join(profiles_dir, cur + '.credentials.json'))
    except Exception as e:
        print('STAY 用量查询失败：%s' % e)
        sys.exit(0)
    update_cache(cur, cache_entry(data))
    write_statusline_file(statusline_text())
    q = quotas(data)
    h5_rem = (q['h5_limit'] - q['h5_used']) if q['h5_limit'] is not None else -1
    w_rem = (q['week_limit'] - q['week_used']) if q['week_limit'] is not None else -1
    # 采样落盘，用相邻两次的差值推算消耗速率，预测下次检查前会不会跌破阈值
    state_path = os.path.join(profiles_dir, '.watch-state.json')
    try:
        prev = load(state_path)
    except Exception:
        prev = None
    save_json(state_path, {'name': cur, 'ts': int(now), 'h5_used': q['h5_used']})
    projected = None
    if prev and prev.get('name') == cur and q['h5_used'] is not None and prev.get('h5_used') is not None:
        dt = now - prev['ts']
        if dt > 0:
            rate = (q['h5_used'] - prev['h5_used']) / dt
            if rate > 0:
                projected = h5_rem - rate * interval
    reason = None
    if w_rem == 0:
        reason = '周额度已用尽'
    elif q['h5_limit'] and h5_rem <= q['h5_limit'] * threshold / 100.0:
        reason = '5h 剩 %d/%d，跌破 %d%% 阈值' % (h5_rem, q['h5_limit'], threshold)
    elif projected is not None and q['h5_limit'] and projected <= q['h5_limit'] * threshold / 100.0:
        reason = '按当前消耗速率，下次检查前 5h 将跌破 %d%% 阈值' % threshold
    if not reason:
        h5s = '%d/%d' % (h5_rem, q['h5_limit']) if q['h5_limit'] is not None else '未知'
        ws = '%d/%d' % (w_rem, q['week_limit']) if q['week_limit'] is not None else '未知'
        print('STAY 当前「%s」余量健康（5h剩%s · 周剩%s）' % (cur, h5s, ws))
        sys.exit(0)
    cands, _, resets = rank_accounts(now, threshold, exclude=cur)
    if cands:
        print('SWITCH %s %s' % (cands[0][0], reason))
        sys.exit(0)
    if q['h5_reset']:
        resets.append(q['h5_reset'])
    future = [r for r in resets if r > now]
    wait = min(1800, int(min(future) - now) + 30) if future else 1800
    print('WAIT %d %s；其他账号 5h 也都不足%s' % (wait, reason, '，睡到最早恢复点' if future else ''))

elif cmd == 'dirs':
    # argv: dirs <dirs_file> <session_index> <cwd>
    # 每个最近项目附带它最近一次会话的标题和时间（会话历史是按项目目录存的）
    dirs_file, index_path, cwd = sys.argv[2], sys.argv[3], sys.argv[4]
    dirs = []
    if os.path.exists(dirs_file):
        dirs = [l.strip() for l in open(dirs_file) if l.strip()]
    if not dirs:
        sys.exit(0)
    last = {}
    if os.path.exists(index_path):
        for line in open(index_path):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if rec.get('workDir'):
                last[rec['workDir']] = rec
    for i, d in enumerate(dirs, 1):
        mark = '（当前位置）' if d == cwd else ('' if os.path.isdir(d) else '（已删除）')
        print('%2d) %s%s' % (i, d, mark))
        rec = last.get(d)
        if rec:
            title, when = '', ''
            try:
                st = load(os.path.join(rec['sessionDir'], 'state.json'))
                title = st.get('title', '')
                ts = int(st.get('updatedAt') or 0) / 1000
                when = datetime.fromtimestamp(ts).strftime('%m-%d %H:%M') if ts else ''
            except Exception:
                pass
            print('     上次会话：%s%s' % (title or '(无标题)', ' · ' + when if when else ''))

elif cmd == 'lastsession':
    # argv: lastsession <session_index> <workdir> —— 打印该目录最近一次会话的 id
    index_path, workdir = sys.argv[2], sys.argv[3]
    sid = ''
    if os.path.exists(index_path):
        for line in open(index_path):
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue
            if rec.get('workDir') == workdir and rec.get('sessionId'):
                sid = rec['sessionId']
    print(sid)

elif cmd == 'applyprefs':
    # argv: applyprefs <config_path> <prefs_file>
    # 把偏好写进 config.toml：default_model / default_permission_mode / [thinking].effort
    import re
    config_path, prefs_file = sys.argv[2], sys.argv[3]
    prefs = {}
    for line in open(prefs_file):
        line = line.strip()
        if line and not line.startswith('#') and '=' in line:
            k, v = line.split('=', 1)
            prefs[k.strip()] = v.strip()
    with open(config_path) as f:
        text = f.read()

    def set_toplevel(text, key, value):
        pat = re.compile(r'(?m)^%s = .*$' % re.escape(key))
        line = '%s = "%s"' % (key, value)
        if pat.search(text):
            return pat.sub(line, text, count=1)
        # 插入到第一个 [section] 之前（顶层区域）
        m = re.search(r'(?m)^\[', text)
        if m:
            return text[:m.start()] + line + '\n\n' + text[m.start():]
        return text.rstrip('\n') + '\n' + line + '\n'

    if prefs.get('model'):
        text = set_toplevel(text, 'default_model', prefs['model'])
    if prefs.get('permission'):
        text = set_toplevel(text, 'default_permission_mode', prefs['permission'])
    if prefs.get('effort'):
        # 只改 [thinking] 段里的 effort
        m = re.search(r'(?ms)^\[thinking\]\n(.*?)(?=^\[|\Z)', text)
        if m:
            body = m.group(1)
            if re.search(r'(?m)^effort = ', body):
                body = re.sub(r'(?m)^effort = .*$', 'effort = "%s"' % prefs['effort'], body, count=1)
            else:
                body = body.rstrip('\n') + '\neffort = "%s"\n' % prefs['effort']
            text = text[:m.start(1)] + body + text[m.end(1):]
        else:
            text = text.rstrip('\n') + '\n\n[thinking]\nenabled = true\neffort = "%s"\n' % prefs['effort']
    with open(config_path, 'w') as f:
        f.write(text)
    applied = ['%s=%s' % (k, prefs[k]) for k in ('model', 'permission', 'effort') if prefs.get(k)]
    print('已套用偏好：%s' % ('，'.join(applied) if applied else '（无可套用项）'))

elif cmd == 'statusline':
    text = statusline_text()
    write_statusline_file(text)
    print(text)

else:
    print('未知子命令 %s' % cmd, file=sys.stderr)
    sys.exit(1)
PYEOF
}

# ---------- 命令 ----------

cmd_save() {
    local name="$1"
    [ -f "$CRED" ] || { echo "错误：还没登录过 Kimi Code，先运行 kimi 并 /login"; exit 1; }
    cp "$CRED" "$PROFILES/${name}.credentials.json"
    chmod 600 "$PROFILES/${name}.credentials.json"
    current_api_key > "$PROFILES/${name}.apikey"
    chmod 600 "$PROFILES/${name}.apikey"
    echo "已保存账号「${name}」"
    ks_py saveinfo "$PROFILES" "$PROFILES/${name}.credentials.json" "$CRED" 2>/dev/null || true
}

cmd_use() {
    local name="$1"
    local snap="$PROFILES/${name}.credentials.json"
    [ -f "$snap" ] || { echo "错误：没有账号「${name}」，先 kimi-switch save ${name}"; exit 1; }
    # 先把 live 里（可能被 CLI 刷新轮转过的）最新凭证回同步到当前账号的快照
    ks_py synclive "$PROFILES" "$CRED" 2>/dev/null || true
    if is_current "${name}"; then
        echo "当前已经是「${name}」，无需切换"
        mark_current "${name}"
        return
    fi
    # 前置校验：换入的快照必须能刷新（refresh_token 有效）。
    # 失效凭证装进 live 的话，CLI 刷新失败会把它写成空 token 墓碑，必须拦在这里。
    local rc=0
    ks_py freshen "$PROFILES" "$snap" 2>/dev/null || rc=$?
    if [ "$rc" -eq 3 ]; then
        echo "错误：「${name}」的快照已失效（refresh_token 已被轮转），请 /login 后重新 save"
        exit 1
    elif [ "$rc" -ne 0 ]; then
        echo "警告：快照校验失败（网络问题？），按原样切换"
    fi
    # 原子安装：CLI 每次请求都重读这个文件，非原子写可能被读到半截 JSON
    local tmp="$CRED.tmp.$$"
    cp "$snap" "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$CRED"
    [ -f "$PROFILES/${name}.apikey" ] && write_api_key "$(cat "$PROFILES/${name}.apikey")"
    mark_current "${name}"
    echo "已切换到「${name}」"
    echo "运行中的 kimi 会话下一次请求就会自动用上新账号，无需重启"
    [ -n "${KS_FROM_WATCH:-}" ] || resume_hint
}

# 记录当前目录到最近项目列表（去重、最多 20 条、最新在最前）
record_dir() {
    local dir="$1"
    [ "$dir" = "$HOME" ] && return   # 主目录不算项目
    touch "$DIRS"
    chmod 600 "$DIRS"
    local tmp="$DIRS.tmp.$$"
    { echo "$dir"; grep -vxF "$dir" "$DIRS" 2>/dev/null || true; } | head -20 > "$tmp"
    mv "$tmp" "$DIRS"
}

# 取最近项目列表第 N 条（1 起）
dir_at() {
    sed -n "${1}p" "$DIRS" 2>/dev/null
}

# 打印目录路径：经 ks.cmd 调用时（CMD/PowerShell）转成 Windows 形式，否则 PowerShell 的 cd 不认 /d/... 形式
print_dir() {
    if [ "${KS_VIA_CMD:-}" = "1" ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        printf '%s\n' "$1"
    fi
}

# 自动选余量最多的账号，套用偏好设置，然后启动 kimi
# 用法：ks go               在当前目录启动新会话（并记录目录）
#       ks go last          跳回上一个项目，接着上次的对话继续聊
#       ks go <编号>        跳到 ks dirs 里的第 N 个项目，接着上次的对话继续聊
#       ks go last new      跳回去但开新会话
cmd_go() {
    local jumped=0
    if [ "${1:-}" = "last" ] || [[ "${1:-}" =~ ^[0-9]+$ ]]; then
        local target=""
        if [ "$1" = "last" ]; then
            local i=1
            while :; do
                local d
                d=$(dir_at "$i")
                [ -z "$d" ] && break
                if [ "$d" != "$PWD" ]; then target="$d"; break; fi
                i=$((i + 1))
            done
            [ -n "$target" ] || { echo "错误：还没有最近项目记录，先在项目目录里跑一次 ks go"; exit 1; }
        else
            target=$(dir_at "$1")
            [ -n "$target" ] || { echo "错误：最近项目列表里没有第 $1 条（ks dirs 查看）"; exit 1; }
        fi
        [ -d "$target" ] || { echo "错误：目录已不存在：$target"; exit 1; }
        echo "跳回项目：$target"
        cd "$target"
        jumped=1
        shift
    fi

    local best
    best=$(ks_py best "$PROFILES" "$CRED" "$CACHE" "$(pref_val threshold 10)" 2>/dev/null | tail -1)
    if [ -n "$best" ] && ! is_current "$best"; then
        cmd_use "$best"
    elif [ -n "$best" ]; then
        mark_current "$best"
        echo "当前账号「${best}」余量最多，直接启动"
    else
        echo "用量查询失败，保持当前账号" >&2
    fi
    ks_py applyprefs "$CONFIG" "$PREFS" 2>/dev/null || true
    record_dir "$PWD"

    # 跳回项目时，默认接着该项目上次的会话继续（对话历史是按项目目录存的）
    local want_new=0
    if [ "$jumped" -eq 1 ] && [ "${1:-}" = "new" ]; then
        want_new=1
        shift
    fi
    if [ "$jumped" -eq 1 ] && [ "$want_new" -eq 0 ]; then
        local sid
        sid=$(ks_py lastsession "$KIMI_HOME/session_index.jsonl" "$PWD" 2>/dev/null | tail -1)
        if [ -n "$sid" ]; then
            echo "恢复上次会话：$sid"
            exec kimi --session "$sid" "$@"
        else
            echo "这个项目还没有会话记录，开新会话"
        fi
    fi
    exec kimi "$@"
}

# 列出最近项目目录（含各项目上次的会话标题）
cmd_dirs() {
    if [ ! -s "$DIRS" ]; then
        echo "（还没有记录。ks go 启动时会自动记下当前项目目录）"
        return
    fi
    ks_py dirs "$DIRS" "$KIMI_HOME/session_index.jsonl" "$PWD"
    echo
    echo "跳回去接着聊：ks go <编号>    只跳回不启动：cd \"\$(ks dir <编号>)\""
}

# 只打印目录路径（供 cd "$(ks dir last)" 用）
cmd_dir() {
    local n="${1:-last}"
    if [ "$n" = "last" ]; then
        local i=1 d=""
        while :; do
            d=$(dir_at "$i")
            [ -z "$d" ] && break
            [ "$d" != "$PWD" ] && break
            i=$((i + 1)); d=""
        done
        [ -n "$d" ] && [ -d "$d" ] && { print_dir "$d"; return; }
        echo "错误：没有可用的最近项目" >&2; exit 1
    fi
    local d
    d=$(dir_at "$n")
    [ -n "$d" ] && [ -d "$d" ] && { print_dir "$d"; return; }
    echo "错误：没有第 $n 条记录或目录已删除" >&2; exit 1
}

# 查看 / 修改启动偏好（go 启动前自动套用到 config.toml）
cmd_prefs() {
    if [ $# -eq 0 ]; then
        echo "当前偏好（model/permission/effort 在每次 go 启动前套用到 config.toml）："
        cat "$PREFS"
        echo
        echo "平衡策略参数：threshold=$(pref_val threshold 10)（5h 剩余百分比阈值），interval=$(pref_val interval 180)（watch 检查间隔秒）"
        echo
        echo "修改示例：kimi-switch prefs model kimi-code/k3"
        echo "          kimi-switch prefs permission auto|yolo|manual"
        echo "            （auto=全程不确认直接执行；yolo=常规自动，危险命令/敏感文件仍确认；manual=每步确认）"
        echo "          kimi-switch prefs effort low|high|max"
        echo "          kimi-switch prefs threshold 10"
        echo "          kimi-switch prefs interval 180"
        return
    fi
    local key="$1" value="${2:-}"
    case "$key" in
        model|permission|effort|threshold|interval) ;;
        *) echo "未知偏好项「${key}」，可选：model / permission / effort / threshold / interval"; exit 1 ;;
    esac
    [ -n "$value" ] || { echo "用法: kimi-switch prefs ${key} <值>"; exit 1; }
    case "$key" in
        threshold|interval)
            case "$value" in
                ''|*[!0-9]*) echo "${key} 必须是数字"; exit 1 ;;
            esac ;;
    esac
    if grep -q "^${key}=" "$PREFS"; then
        sed_i "s|^${key}=.*|${key}=${value}|" "$PREFS"
    else
        echo "${key}=${value}" >> "$PREFS"
    fi
    echo "已设置 ${key}=${value}"
    ks_py applyprefs "$CONFIG" "$PREFS" 2>/dev/null || true
}

# 找出当前目录最近一次的会话，提示如何恢复（聊天记录存在本地，不随账号变）
resume_hint() {
    local index="$KIMI_HOME/session_index.jsonl"
    [ -f "$index" ] || return
    [ "${#PY[@]}" -gt 0 ] || return
    local sid
    sid=$("${PY[@]}" -c "
import json, os
cwd = os.getcwd()
last = None
for line in open(r'$(py_path "$index")'):
    line = line.strip()
    if not line:
        continue
    try:
        rec = json.loads(line)
    except json.JSONDecodeError:
        continue
    if rec.get('workDir') == cwd and rec.get('sessionId'):
        last = rec['sessionId']
print(last or '')
" 2>/dev/null)
    if [ -n "$sid" ]; then
        echo "在当前目录继续上次的对话，请运行："
        echo "  kimi --session $sid"
    fi
}

cmd_ls() {
    local found=0
    for f in "$PROFILES"/*.credentials.json; do
        [ -e "$f" ] || continue
        found=1
        local name
        name=$(basename "$f" .credentials.json)
        local mark=" "
        is_current "${name}" && mark="*"
        local ident=""
        if [ -f "$PROFILES/${name}.info" ] && [ "${#PY[@]}" -gt 0 ]; then
            ident=$("${PY[@]}" -c "
import json
d = json.load(open(r'$(py_path "$PROFILES/${name}.info")'))
print(' · ' + ' '.join(x for x in [d.get('nickname',''), d.get('phone','')] if x))
" 2>/dev/null)
        fi
        echo "${mark} ${name}${ident}"
    done
    [ "$found" -eq 1 ] || echo "（还没有保存任何账号，先 /login 后 kimi-switch save <名字>）"
}

cmd_current() {
    for f in "$PROFILES"/*.credentials.json; do
        [ -e "$f" ] || continue
        local name
        name=$(basename "$f" .credentials.json)
        if is_current "${name}"; then
            echo "${name}"
            return
        fi
    done
    echo "（当前登录态不匹配任何已保存的账号）"
}

cmd_rm() {
    local name="$1"
    rm -f "$PROFILES/${name}.credentials.json" "$PROFILES/${name}.apikey" "$PROFILES/${name}.info"
    echo "已删除账号「${name}」"
}

cmd_usage() {
    ks_py usage "$PROFILES" "$CRED" "$CACHE"
}

# 无交互切到有可用额度的最佳其他账号，不启动 kimi、不套用偏好。
# 退出码 3 表示没有可切换的可用账号，适合监督脚本安全调用。
cmd_rotate() {
    local best="" rc=0
    # 被动场景（当前已撞墙）：5h 门槛放宽为 >0，有剩就比没有强
    best=$(ks_py best-other "$PROFILES" "$CRED" "$CACHE" 0 2>/dev/null) || rc=$?
    best=$(printf '%s\n' "$best" | tail -1)
    if [ "$rc" -ne 0 ]; then
        echo "错误：无法查询其他账号额度" >&2
        return 3
    fi
    if [ -z "$best" ]; then
        echo "没有其他仍有可用额度的账号" >&2
        return 3
    fi
    cmd_use "$best"
}

# 按平衡策略选出的账号；-v 显示各账号评分明细（为什么这么选）
cmd_best() {
    local verbose=""
    [ "${1:-}" = "-v" ] && verbose="--verbose"
    ks_py best "$PROFILES" "$CRED" "$CACHE" "$(pref_val threshold 10)" $verbose
}

# 系统通知（仅 macOS，best-effort；经环境变量传参，避免名字里的引号注进 AppleScript）
watch_notify() {
    [ "$(uname -s)" = "Darwin" ] || return 0
    command -v osascript >/dev/null 2>&1 || return 0
    KS_NTITLE="$1" KS_NBODY="$2" osascript -e \
        'display notification (system attribute "KS_NBODY") with title (system attribute "KS_NTITLE")' \
        >/dev/null 2>&1 || true
}

# 5h 预判守护：当前账号快用超前，按平衡策略自动热切走
# 用法：kimi-switch watch [--once] [--interval 秒] [--threshold 百分比]
cmd_watch() {
    local once=0
    local interval threshold
    interval=$(pref_val interval 180)
    threshold=$(pref_val threshold 10)
    while [ $# -gt 0 ]; do
        case "$1" in
            --once)      once=1 ;;
            --interval)  shift; interval="${1:-}" ;;
            --threshold) shift; threshold="${1:-}" ;;
            *) echo "未知参数「$1」（可用：--once / --interval 秒 / --threshold 百分比）" >&2; return 1 ;;
        esac
        shift
    done
    case "$interval" in ''|*[!0-9]*) echo "interval 必须是正整数秒" >&2; return 1 ;; esac
    case "$threshold" in ''|*[!0-9]*) echo "threshold 必须是 0-100 的数字" >&2; return 1 ;; esac
    [ "$once" -eq 1 ] || echo "watch 已启动：每 ${interval}s 检查一次，5h 剩余 ≤${threshold}% 或预测用超前自动热切（Ctrl-C 停止）"
    while :; do
        local out action rest
        out=$(ks_py watchcheck "$PROFILES" "$CRED" "$CACHE" "$threshold" "$interval" 2>/dev/null | tail -1 || true)
        action=$(printf '%s' "$out" | cut -d' ' -f1)
        rest=$(printf '%s' "$out" | cut -d' ' -f2-)
        case "$action" in
            STAY)
                if [ "$once" -eq 1 ]; then echo "$rest"; return 0; fi
                ;;
            SWITCH)
                local target why
                target=$(printf '%s' "$rest" | cut -d' ' -f1)
                why=$(printf '%s' "$rest" | cut -d' ' -f2-)
                echo "[$(date '+%H:%M:%S')] 当前账号 ${why} → 热切换到「${target}」"
                if KS_FROM_WATCH=1 cmd_use "$target"; then
                    watch_notify "kimi-switch 自动换号" "已切到「${target}」（${why}）"
                fi
                [ "$once" -eq 1 ] && return 0
                ;;
            WAIT)
                local secs why
                secs=$(printf '%s' "$rest" | cut -d' ' -f1)
                why=$(printf '%s' "$rest" | cut -d' ' -f2-)
                case "$secs" in ''|*[!0-9]*) secs="$interval" ;; esac
                echo "[$(date '+%H:%M:%S')] ${why}，${secs}s 后再查"
                watch_notify "kimi-switch 额度预警" "$why"
                [ "$once" -eq 1 ] && return 3
                sleep "$secs"
                continue
                ;;
            *)
                echo "[$(date '+%H:%M:%S')] 检查失败（网络问题？），下个周期重试" >&2
                [ "$once" -eq 1 ] && return 1
                ;;
        esac
        sleep "$interval"
    done
}

cmd_auto() {
    local names=()
    for f in "$PROFILES"/*.credentials.json; do
        [ -e "$f" ] || continue
        names+=("$(basename "$f" .credentials.json)")
    done
    if [ "${#names[@]}" -eq 0 ]; then
        echo "还没有保存任何账号。用法："
        echo "  1. kimi 里 /login 登录账号 A，然后 kimi-switch save A"
        echo "  2. kimi 里 /login 换登录账号 B，然后 kimi-switch save B"
        echo "  3. 以后直接 kimi-switch 即可一键互换"
        exit 0
    elif [ "${#names[@]}" -eq 1 ]; then
        echo "只保存了一个账号「${names[0]}」，再 save 一个才能切换"
        exit 0
    elif [ "${#names[@]}" -eq 2 ]; then
        local other=""
        for n in "${names[@]}"; do
            is_current "$n" || other="$n"
        done
        if [ -z "$other" ]; then
            other="${names[0]}"
        fi
        cmd_use "$other"
    else
        echo "选择要切换的账号："
        local i=1
        for n in "${names[@]}"; do
            if is_current "$n"; then
                echo "  $i) ${n}（当前）"
            else
                echo "  $i) $n"
            fi
            i=$((i + 1))
        done
        printf "输入编号: "
        read -r pick
        case "$pick" in
            ''|*[!0-9]*) echo "已取消"; exit 1 ;;
        esac
        [ "$pick" -ge 1 ] && [ "$pick" -le "${#names[@]}" ] || { echo "无效编号"; exit 1; }
        cmd_use "${names[$((pick - 1))]}"
    fi
}

cmd_help() {
    cat <<'EOF'
kimi-switch — 一键切换 Kimi Code CLI 账号

【首次设置（只做一次）】
  1. 在 kimi 里 /login 登录账号 A，然后运行:  kimi-switch save A
  2. 在 kimi 里 /login 换成账号 B，再运行:    kimi-switch save B
  （名字随便起，中文也行，比如 kimi-switch save 主号）

【日常使用】
  kimi-switch              一键互换（只存了两个账号时最常用）
  kimi-switch go           自动选号 + 套用偏好并启动 kimi（当前目录开新会话）
  kimi-switch go <编号>    跳回最近项目并接着上次的对话聊（last = 上一个项目）
  kimi-switch dirs         最近项目列表，附各项目上次的会话标题和时间
  kimi-switch dir <编号>   只打印项目路径（配合 cd "$(ks dir 2)" 使用）
  kimi-switch prefs        查看/修改启动偏好（prefs model|permission|effort 值）
  kimi-switch usage        查看所有账号的用量（5小时窗口 / 每周额度 / 加油包）
  kimi-switch rotate       无交互切到有额度的最佳其他账号，不启动 kimi
  kimi-switch best [-v]    按平衡策略选出的账号（-v 显示各账号评分明细）
  kimi-switch watch        5h 预判守护：快用超前自动热切（--once 单次，给 launchd/cron）
  kimi-switch synclive     把 live 里 CLI 刷新过的最新凭证回同步到当前账号快照（usage/use 已自动做）
  kimi-switch ls           列出所有账号（含昵称），* 号 = 当前生效
  kimi-switch current      只显示当前账号名
  kimi-switch use <名字>   切换到指定账号（热切，运行中的会话下一次请求即生效）
  kimi-switch save <名字>  把当前登录态存为账号快照
  kimi-switch rm <名字>    删除某个账号快照
  kimi-switch statusline   状态栏输出（配置在 tui.toml 的 status_line.command）
  kimi-switch help         显示本帮助

【5 小时额度用尽时】
  1. 至少先保存两个账号：kimi-switch save <名字>
  2. 查看所有账号额度：kimi-switch usage
  3. 当前账号额度用尽后：kimi-switch rotate

  rotate 会排除当前账号和无可用额度的账号，切到剩余额度最多的账号。
  它不会启动新会话或修改模型/思考档位；运行中的 Kimi 下一次请求即生效。
  没有可用备用账号时保持当前账号不变，并返回退出码 3。
  自动化程序应仅在 QUOTA_EXCEEDED_ERR 或 QuotaExceededError 后调用 rotate。

【自动平衡策略（best / go / rotate / watch 共用）】
  优先级：5h 可用（门槛，默认剩 10%）> 周重置紧迫度 > 5h 余量 > 周余量。
  紧迫度 = 周剩余占比 − 本周期剩余时间占比：谁快重置且剩得多就先用谁，
  谁也不欠谁的节奏就退化为"谁剩得多用谁"。当前账号与最优者同档时保持不动。
  用 kimi-switch best -v 可查看每个账号的评分明细。

【5h 预判热切（watch）】
  kimi-switch watch 常驻检查（默认每 180s）：当前账号 5h 剩余跌破阈值
  （threshold 偏好，默认 10%），或按最近两次采样的消耗速率预测下次检查前
  会跌破，就立即按平衡策略热切到最佳账号并弹系统通知——在用超之前切走。
  所有账号都不足时睡到最早的 5h 恢复点再查。--once 单次检查，配合
  launchd/cron 定时执行；无可切账号时返回退出码 3（同 rotate）。

【注意】
  · 切换对运行中的 kimi 会话即时生效（CLI 每次请求都重读凭证文件），无需重启
  · 状态栏用量来自本地缓存，由 usage / go 命令刷新
  · 快照存在 ~/.kimi-code/accounts/（权限 600），不会打印密钥
EOF
}

case "${1:-}" in
    help|-h|--help) cmd_help ;;
    save)    [ -n "${2:-}" ] || { echo "用法: kimi-switch save <名字>"; exit 1; }; cmd_save "$2" ;;
    use)     [ -n "${2:-}" ] || { echo "用法: kimi-switch use <名字>"; exit 1; }; cmd_use "$2" ;;
    go)      shift; cmd_go "$@" ;;
    dirs)    cmd_dirs ;;
    dir)     cmd_dir "${2:-last}" ;;
    prefs)   shift; cmd_prefs "$@" ;;
    rotate)  cmd_rotate ;;
    best)    cmd_best "${2:-}" ;;
    watch)   shift; cmd_watch "$@" ;;
    ls)      cmd_ls ;;
    current) cmd_current ;;
    rm)      [ -n "${2:-}" ] || { echo "用法: kimi-switch rm <名字>"; exit 1; }; cmd_rm "$2" ;;
    synclive)  ks_py synclive "$PROFILES" "$CRED" ;;
    usage|status) cmd_usage ;;
    statusline) cat "$PROFILES/.statusline.txt" 2>/dev/null || ks_py statusline "$PROFILES" "$CRED" "$CACHE" ;;
    "")      cmd_auto ;;
    *)       echo "未知命令「$1」。可用：save / use / rotate / best / watch / go / prefs / usage / synclive / ls / current / rm / statusline，或不带参数一键切换"; exit 1 ;;
esac
